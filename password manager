print("PASSWORD MANAGER")

passwords = {
    "facebook": "abc123",
    "youtube": "qwerty"
}

while True:

    print("")
    print("1 = vedere password")
    print("2 = aggiungere password")
    print("3 = uscire")

    scelta = input("Cosa vuoi fare: ")

    if scelta == "1":

        servizio = input("Nome servizio: ")

        if servizio in passwords:
            print("La password è:")
            print(passwords[servizio])
        else:
            print("Servizio non trovato")

    elif scelta == "2":

        nuovo_servizio = input("Nuovo servizio: ")
        nuova_password = input("Nuova password: ")

        passwords[nuovo_servizio] = nuova_password

        print("Password aggiunta")

    elif scelta == "3":

        print("Chiusura programma")
        break

    else:
        print("Scelta non valida")